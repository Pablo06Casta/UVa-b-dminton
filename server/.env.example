# --- Obligatorio ---
# Token del panel de administración (/admin). Sin él, la administración queda desactivada.
ADMIN_TOKEN=
# Dónde guarda la base de datos (usa un disco persistente).
DATA_DIR=./data
# Web del club (para los enlaces de «compartir» y de los avisos) y orígenes que pueden leer la API.
SITE_URL=https://pablo06casta.github.io/UVa-b-dminton
CORS_ORIGINS=https://pablo06casta.github.io

# --- Calendario oficial (rutas permitidas por robots.txt). Cada 6 h. ---
CALENDAR_REFRESH_ENABLED=true

# --- Lectura EN DIRECTO de badminton.es: DESACTIVADA por defecto ---
# Las rutas con inscritos, cuadros, partidos y perfiles están excluidas por el robots.txt de badminton.es.
# Actívala solo con autorización de la FESBA / Federación de Castilla y León.
OFFICIAL_READ_ENABLED=false

# --- Avisos push (genera las claves con: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Privacidad ---
# Rivales: none (por defecto) o names. Cuadros: initials (por defecto), full u off.
PUBLIC_OPPONENTS=none
PUBLIC_DRAW_NAMES=initials

# --- Frecuencias (minutos). Valores por defecto razonables ---
# DISCOVERY_MINUTES=120
# BEFORE_INFO_MINUTES=240    BEFORE_DRAWS_MINUTES=240
# IMMINENT_INFO_MINUTES=60   IMMINENT_DRAWS_MINUTES=20
# LIVE_DAY_MINUTES=5         LIVE_DRAWS_MINUTES=20
# MIN_REQUEST_INTERVAL_MS=2500   (nunca por debajo de 2500)
