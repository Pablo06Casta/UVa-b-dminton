{
  "name": "club-badminton-uva-server",
  "private": true,
  "version": "0.1.0",
  "description": "Servidor del club: lista de jugadores, sincronización prudente con badminton.es y API pública de solo lectura",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:copy": "node scripts/copy-fixtures.mjs",
    "demo": "tsx scripts/demo.ts",
    "vapid": "node scripts/vapid.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "luxon": "^3.7.2",
    "web-push": "^3.6.7",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
